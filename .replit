modules = ["python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TenderGraph API"

[[workflows.workflow]]
name = "TenderGraph API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m alembic -c backend/alembic.ini upgrade head && uvicorn backend.main:app --host localhost --port 8000 --reload"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 8000
externalPort = 8000
exposeLocalhost = true
